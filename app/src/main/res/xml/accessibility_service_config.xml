<?xml version="1.0" encoding="utf-8"?>
<!--
  Subscription list for TyporbAccessibilityService.

  These are the events that can change where the input focus is or whether a keyboard is on screen: a
  tap, a focus move, a window transition, a change to the window list (which is how the platform
  announces that a keyboard appeared or went away), and text changes.

  `typeWindowContentChanged` is deliberately NOT subscribed. It fires on every keystroke in the app
  and on every redraw inside the keyboard, and each one would cost a focused-node fetch plus a
  window-list fetch — a per-keystroke IPC flood that buys nothing, because typing cannot move focus.

  `flagRetrieveInteractiveWindows` is what lets `getWindows()` include the keyboard window, and
  `canRetrieveWindowContent` is required to read the focused field at all.

  `flagInputMethodEditor` is what lets the service commit text through the platform's own input
  connection on Android 13+ — the same route a keyboard uses, and the only way to type into a field
  that refuses `ACTION_SET_TEXT` and `ACTION_PASTE` alike. The attribute is resolved to its integer at
  build time, so on Android 12 and older (this app's minimum is 26, and the phone it targets is 11) it
  is a flag bit nothing reads, and Typorb's node routes are unaffected.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused|typeViewClicked|typeViewTextChanged|typeWindowStateChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews|flagInputMethodEditor"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="50"
    android:settingsActivity="com.typorb.ui.dashboard.MainActivity"
    android:summary="@string/accessibility_service_label" />